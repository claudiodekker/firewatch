{
    "name": "claudiodekker/firewatch",
    "description": "Local Laravel Nightwatch telemetry for AI assistants over MCP.",
    "type": "library",
    "keywords": ["laravel", "nightwatch", "mcp", "telemetry"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-sqlite3": "*",
        "illuminate/support": "^12.0|^13.0",
        "laravel/mcp": "^1.0.1",
        "laravel/nightwatch": "^1.30.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "ClaudioDekker\\Firewatch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClaudioDekker\\Firewatch\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ClaudioDekker\\Firewatch\\FirewatchServiceProvider"
            ],
            "dont-discover": [
                "laravel/nightwatch"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "@php vendor/bin/pest",
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "fixtures": "@php vendor/bin/testbench workbench:fixtures --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
